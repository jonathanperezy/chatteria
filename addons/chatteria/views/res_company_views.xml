<odoo>
    <record id="view_company_form" model="ir.ui.view">
        <field name="name">view_company_form</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <notebook position="inside">
                <page string="Security Gemini" groups="base.group_system">
                    <group string="Token &amp; Parameters">
                        <field name="api_gemini_token" />
                    </group>
                    <group>
                        <field name="allowed_url_ids" nolabel="1">
                            <list>
                                <field name="name" string="Allowed Url" />
                                <field name="available" />
                            </list>
                        </field>
                    </group>
                </page>
            </notebook>
        </field>
    </record>
</odoo>